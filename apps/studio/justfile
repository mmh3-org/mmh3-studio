# Recipes for the studio. Run from the repo root as `just studio::<recipe>`,
# or from this directory as `just <recipe>`.

[private]
default:
    @just --list

# Run the studio against a server (default: $MMH3_SERVER or 127.0.0.1:8833)
[positional-arguments]
run *args:
    cargo run --release --bin mmh3-studio -- "$@"

# Run the studio against a mock server started alongside it
run-mock:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo build --release --bin mmh3-studio --bin mock-server
    bin="${CARGO_TARGET_DIR:-../../target}/release"
    "$bin/mock-server" --listen 127.0.0.1:8833 --step 0.6 &
    mock=$!
    trap 'kill "$mock"' EXIT
    "$bin/mmh3-studio" --server http://127.0.0.1:8833

# Serve the mmh3 API from the mock, without the engine
mock-server listen="127.0.0.1:8833" step="0.6":
    cargo run --release --bin mock-server -- --listen {{listen}} --step {{step}}

# Run the client, mock, state machine and UI tests
test:
    cargo test --release

# Render the headless scenes and a live mock run into screenshots/
screenshots:
    cargo build --release --bin mmh3-studio --bin mock-server
    sh scripts/screenshots.sh

# Build the web studio into a static folder (default: target/web), served beside mmh3's /v1
web-build out="../../target/web":
    #!/usr/bin/env bash
    set -euo pipefail
    rune=$(just _rune)
    mkdir -p "{{out}}"
    cp ../studio-web/index.html "{{out}}/index.html"
    bash "$rune/scripts/web-build.sh" mmh3-studio-web --out "{{out}}"
    # web-build.sh finds Rune's full fonts through dep-info, which leaves out a git dependency's files.
    cp "$rune"/crates/rune/assets/web/Inter-*.ttf "{{out}}/"

# Rebuild the web studio on every change (fast, unoptimised); serve it with `web-serve ../../target/web-live`
web-dev out="../../target/web-live":
    #!/usr/bin/env bash
    set -euo pipefail
    rune=$(just _rune)
    mkdir -p "{{out}}"
    cp "$rune"/crates/rune/assets/web/Inter-*.ttf "{{out}}/"
    bash "$rune/scripts/web-build.sh" mmh3-studio-web --dev --watch --out "{{out}}"

# Serve a web build at / and pass /v1 to mmh3 server, on one origin (http://127.0.0.1:8000)
web-serve dir="../../target/web" listen="127.0.0.1:8000" server="127.0.0.1:8833":
    cargo run --release --bin web-proxy -- --dir {{dir}} --listen {{listen}} --server {{server}}

# The checkout of the Rune revision Cargo.lock pins, which carries its web build script
[private]
_rune:
    @dirname "$(dirname "$(dirname "$(cargo metadata --format-version 1 | jq -r '.packages[] | select(.name == "rune") | .manifest_path')")")"

# Run the client against a real mmh3 server; it generates on the GPU, so take the GPU first
test-real server="http://127.0.0.1:8833":
    MMH3_SERVER={{server}} cargo test --release --test real_server -- --ignored --nocapture --test-threads 1
